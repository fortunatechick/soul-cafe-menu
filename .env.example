# WhatsApp number that receives order confirmations (country code, no +)
NEXT_PUBLIC_WA_NUMBER=919326957595

# Store name shown in the UI
NEXT_PUBLIC_STORE_NAME=Soul

# Leave blank to use relative API routes (default for Vercel)
NEXT_PUBLIC_API_URL=

# ---- PetPooja (backend not wired yet — orders are stored in memory until these are set) ----
PETPOOJA_APP_KEY=
PETPOOJA_APP_SECRET=
PETPOOJA_ACCESS_TOKEN=
PETPOOJA_RESTAURANT_ID=388482
PETPOOJA_ORDER_API_URL=https://pos.petpooja.com/V1/save_order

# Public origin, used to build absolute og:image URLs for link previews.
# Vercel sets VERCEL_URL automatically; set this once a custom domain is live.
NEXT_PUBLIC_SITE_URL=

# Optional. Enables reverse geocoding for the "use my location" button via
# Google; without it the server falls back to OpenStreetMap Nominatim (no key).
GOOGLE_MAPS_API_KEY=

# Optional. Set alongside the PetPooja credentials to look returning customers
# up by phone; without it the checkout uses the browser's own saved details.
PETPOOJA_CUSTOMER_API_URL=

# Cloudflare Turnstile — the real bot protection on the order form. Free keys
# from https://dash.cloudflare.com/?to=/:account/turnstile. Without them the
# form falls back to a signed human-check, which is weaker (see README).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional. Signing key for that fallback check; a random per-process value is
# used if unset, which is fine for a 15-minute token.
BOTCHECK_SECRET=
